# Official Sber API sandbox identity, not the GigaChat API key.
SBER_API_P12_PATH=/absolute/path/to/sandbox-client.p12
SBER_API_P12_PASSWORD=replace-with-p12-password
SBER_API_ACCESS_TOKEN=replace-with-sandbox-access-token
# Optional trusted CA bundle for the bank sandbox.
# SBER_API_CA_BUNDLE=/absolute/path/to/trusted-roots.pem
